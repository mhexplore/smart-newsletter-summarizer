# Required — OpenAI (powers gpt-4o-mini)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional — Tavily web search (free tier at https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-key-here

# Default topic for CLI / GitHub Actions (override with --topic or NEWSLETTER_TOPIC)
NEWSLETTER_TOPIC=latest developments in AI agents

# Email (SMTP) — required when using --email or SEND_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=you@example.com,team@example.com

# GitHub Actions: set SEND_EMAIL=true in repo Variables to email on schedule
# SEND_EMAIL=false
